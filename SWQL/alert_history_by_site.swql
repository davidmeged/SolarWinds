SELECT

    CASE
    WHEN AO.AlertConfigurations.Severity = 0 THEN 'Informational'
    WHEN AO.AlertConfigurations.Severity = 1 THEN 'Warning'
    WHEN AO.AlertConfigurations.Severity = 2 THEN 'Critical'
    WHEN AO.AlertConfigurations.Severity = 3 THEN 'Serious'
    WHEN AO.AlertConfigurations.Severity = 4 THEN 'Notice'
    ELSE 'Unknown' END as [Severity]

    ,ISNULL(AO.RelatedNodeCaption, AO.EntityCaption) as [Object]
    ,AO.RelatedNodeDetailsUrl as [Link]
    ,AO.Node.IP_Address as [IP Address]
    ,AH.Message as [Message]
    ,ToLocal(AH.TimeStamp) as [Trigger Time]
    ,ToLocal(reset.ResetTime) as [Reset Time]

FROM Orion.AlertHistory AH

JOIN Orion.AlertObjects AO ON AO.AlertObjectID = AH.AlertObjectID

-- One reset per trigger: the earliest Reset (1) / Cleared (8) event of the same activation
LEFT JOIN (
    SELECT AlertActiveID, AlertObjectID, MIN(TimeStamp) as ResetTime
    FROM Orion.AlertHistory
    WHERE EventType IN (1,8)
    GROUP BY AlertActiveID, AlertObjectID
) reset ON reset.AlertActiveID = AH.AlertActiveID AND reset.AlertObjectID = AH.AlertObjectID

-- One row per node, even if it belongs to several matching containers
JOIN (
    SELECT DISTINCT cm.MemberPrimaryID as NodeID
    FROM Orion.ContainerMembers cm
    WHERE cm.MemberEntityType = 'Orion.Nodes'
        AND cm.Container.Name LIKE 'Site 1223%'
) site ON site.NodeID = AO.RelatedNodeId

WHERE AH.EventType = 0

ORDER BY AH.TimeStamp DESC
